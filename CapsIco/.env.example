# Copy this file to .env and fill in project-specific values.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app/
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Add other environment variables as needed. Do not commit sensitive information to version control.
# Will only be used in development environment.

# 1. Copy `.env.example` to `.env` and fill in the Firebase values supplied from the Google Cloud console.
# 2. Keep the `.env` file out of version control (already enforced via `.gitignore`). Never paste real keys in pull requests, issues, or shared screenshots.
# 3. When sharing the project, commit only `.env.example` so other developers can provide their own secrets.
#- Ico 